; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="东方冰华战线：冰封幻想乡"
config/description="基地建设、军团指挥与冰霜魔法的即时战略远征"
; Keep the existing save directory when changing the displayed project name.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/琪露诺的智商保卫战"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon_placeholder.svg"

[autoload]

UISoundManager="*res://scripts/autoload/ui_sound_manager.gd"

[display]

window/size/viewport_width=1180
window/size/viewport_height=660
window/size/window_width_override=1180
window/size/window_height_override=660
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/fonts/default_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.11, 1)
