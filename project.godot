; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="琪露诺的智商保卫战"
config/description="雾之湖第一关塔防 Roguelike 原型"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon_placeholder.svg"

[gui]

theme/custom="res://assets/fonts/default_theme.tres"

[display]

window/size/viewport_width=1180
window/size/viewport_height=660
window/size/window_width_override=1180
window/size/window_height_override=660
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.11, 1)
